{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "vite.config.ts",
    "seo/**/*.ts",
    "src/seo/site.ts",
    "src/data/**/*.ts",
    "src/types/**/*.ts"
  ]
}
