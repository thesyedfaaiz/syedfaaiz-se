# =============================================================================
# Syed Faaiz Engineering — client environment
# Copy to .env for local overrides. Production: https://se.syedfaaiz.com
# =============================================================================

# Analytics (optional; production builds and public SEO pages only)
# Create a GA4 web data stream and use its Measurement ID (format: G-XXXXXXXXXX).
# Set this in the production host's environment and redeploy; VITE_* values are
# embedded in the client bundle at build time. Leave blank to disable.
VITE_GA_MEASUREMENT_ID=

# Optional additional analytics script. Must be a complete HTTPS URL.
VITE_TRACKING_SCRIPT_URL=
